# Copy to `.env` (git-ignored); the server auto-loads it on boot. Real
# environment variables always win over values in this file.
#
# Any secret below also supports a `<NAME>_FILE` variant that reads the value
# from the given path — for Docker Secrets, e.g. DAMSON_POSTGRES_DSN_FILE=/run/secrets/db_dsn.
# Set either the direct var or the _FILE variant, never both.

DAMSON_POSTGRES_DSN=postgres://damson:damson@localhost:5432/damson?sslmode=disable

# ─── Server (optional; defaults shown) ─────────────────────────────────────

# DAMSON_LISTEN_ADDR=:8080
# DAMSON_BASE_URL=http://localhost:8080
# DAMSON_LOG_LEVEL=info      # debug | info | warn | error
# GIN_MODE=debug             # release in prod

# ─── Auth mode ─────────────────────────────────────────────────────────────

# Default is local. Flip to `oidc` to use the OIDC path.
# DAMSON_AUTH_MODE=local

# ─── Local auth mode (default) ─────────────────────────────────────────────

# JWT signing key. Leave unset and the server auto-generates 32 random bytes
# on first boot into DAMSON_JWT_KEY_FILE (default ./data/jwt.key).
# DAMSON_JWT_SIGNING_KEY=
# DAMSON_JWT_KEY_FILE=./data/jwt.key

# Env-seeded first admin. Leave BOTH unset to use the in-app bootstrap page
# (GET /bootstrap in the SPA; POST /api/auth/bootstrap). Set BOTH to seed at
# startup instead.
# DAMSON_LOCAL_ADMIN_EMAIL=admin@example.com
# DAMSON_LOCAL_ADMIN_PASSWORD=change-me

# ─── OIDC auth mode ────────────────────────────────────────────────────────

# Required when DAMSON_AUTH_MODE=oidc:
# DAMSON_OIDC_ISSUER_URL=https://auth.example.com
# DAMSON_OIDC_CLIENT_ID=damson
# DAMSON_OIDC_AUDIENCE=damson
# DAMSON_BOOTSTRAP_ADMIN_EMAILS=you@example.com,other@example.com

# ─── Storage mode ──────────────────────────────────────────────────────────

# Default is local. Flip to `s3` for MinIO / AWS.
# DAMSON_STORAGE_MODE=local

# ─── Local storage mode (default) ──────────────────────────────────────────

# DAMSON_STORAGE_LOCAL_PATH=./data/blobs

# ─── S3 storage mode ───────────────────────────────────────────────────────

# Required when DAMSON_STORAGE_MODE=s3. Path-style on by default for MinIO.
# DAMSON_S3_ENDPOINT=http://localhost:9000
# DAMSON_S3_REGION=us-east-1
# DAMSON_S3_BUCKET=damson
# DAMSON_S3_ACCESS_KEY=minioadmin
# DAMSON_S3_SECRET_KEY=minioadmin
# DAMSON_S3_FORCE_PATH_STYLE=true
